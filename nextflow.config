manifest {
    name = 'schwarzlab-ccb/pipeline-ase'
    mainScript = 'pipeline-ase.nf'
    version = '1.0.0'
    nextflowVersion = '>=21.04.0'
    description = 'Allele-specific expression analysis from RNA-seq data'
    author = 'Adam Streck'
    homePage = 'https://github.com/schwarzlab-ccb/pipeline-ase'
}

trace {
    enabled = true
    file = "${params.out_dir}/execution_trace.txt"
    overwrite = true
}

report {
    enabled = true
    file = "${params.out_dir}/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.out_dir}/execution_timeline.html"
    overwrite = true
}
